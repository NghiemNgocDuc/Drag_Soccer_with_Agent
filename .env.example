# Copy this to .env and fill in your values
SECRET_KEY=generate-a-random-secret-here

# Supabase — https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Upstash Redis — https://console.upstash.com
UPSTASH_REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ProductBridge — https://app.productbridge.io/settings
PRODUCTBRIDGE_API_KEY=pb_your-api-key
PRODUCTBRIDGE_BOARD_ID=your-board-id

# Clerk — https://clerk.com/docs/backend-requests/overview
CLERK_SECRET_KEY=sk_test_your-secret-key
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# PostHog — https://us.posthog.com/project/settings
POSTHOG_API_KEY=phc_your-api-key
POSTHOG_HOST=https://us.i.posthog.com

# Sentry — https://sentry.io/settings/projects/<project>/keys/
SENTRY_DSN=https://your-dsn@sentry.io/123

# Pinecone — https://app.pinecone.io/organizations/.../indexes
PINECONE_API_KEY=pcsk_your-api-key
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX=soccer-agent

# Semantic Scholar — https://www.semanticscholar.org/product/api (optional, higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=
