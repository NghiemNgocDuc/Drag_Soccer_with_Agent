# Copy this to .env. For local play, set DEV_MODE=1; service keys can stay empty.
# Production: keep DEV_MODE=0, generate a SECRET_KEY, and configure auth + Redis.
DEV_MODE=0
SECRET_KEY=
# Public deployment URL used in password recovery and account email links.
SITE_URL=http://localhost:5000

# Built-in AI: shared thinking budget and maximum speculative physics runs.
# Lower values favor responsiveness; valid ranges are 20-1000 ms and 1-64 runs.
AI_DECISION_BUDGET_MS=120
AI_MAX_SIMULATIONS=12

# Supabase — https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Redis — local fallback is available; deployed online matches need shared Redis.
# Upstash URL format: rediss://default:password@endpoint.upstash.io:6379
UPSTASH_REDIS_URL=redis://localhost:6379

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
FEEDBACK_TO_EMAIL=

# ProductBridge — https://app.productbridge.io/settings
PRODUCTBRIDGE_API_KEY=
PRODUCTBRIDGE_BOARD_ID=

# Clerk — https://clerk.com/docs/backend-requests/overview
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# PostHog — https://us.posthog.com/project/settings
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Sentry — https://sentry.io/settings/projects/<project>/keys/
SENTRY_DSN=

# Pinecone — https://app.pinecone.io/organizations/.../indexes
PINECONE_API_KEY=
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX=soccer-agent

# Semantic Scholar — https://www.semanticscholar.org/product/api (optional, higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Optional avatar moderation: sightengine, moderatecontent, or google.
MODERATION_PROVIDER=
MODERATION_API_KEY=
MODERATION_API_SECRET=
